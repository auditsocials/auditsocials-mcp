{
  "name": "auditsocials-mcp",
  "version": "0.1.1",
  "mcpName": "io.github.eminegurcu/auditsocials-mcp",
  "description": "MCP server exposing the AuditSocials Social Media Advertising Compliance Glossary (212 terms, CC BY 4.0) — define and search platform-policy, advertising-compliance, and enforcement terminology.",
  "type": "module",
  "license": "CC-BY-4.0",
  "author": "Emine Gürcü (Product Lead, AuditSocials)",
  "homepage": "https://www.auditsocials.com/knowledge/glossary",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/auditsocials/auditsocials-mcp.git"
  },
  "keywords": [
    "mcp",
    "model-context-protocol",
    "glossary",
    "advertising-compliance",
    "platform-policy",
    "regtech",
    "dsa",
    "gdpr",
    "ftc",
    "auditsocials"
  ],
  "bin": {
    "auditsocials-mcp": "dist/index.js"
  },
  "files": [
    "dist",
    "README.md"
  ],
  "scripts": {
    "build": "rm -rf dist && tsc && cp -R src/data dist/data",
    "export-glossary": "tsx scripts/export-glossary.ts",
    "start": "node dist/index.js",
    "prepublishOnly": "npm run build"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.12.0",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "tsx": "^4.19.0",
    "typescript": "^5.5.0",
    "@types/node": "^20.14.0"
  },
  "engines": {
    "node": ">=18"
  }
}
